{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jelto.io/spec/wire-v1.schema.json",
  "title": "Jelto ingest envelope v1",
  "$comment": "Executable form of spec/wire-v1.md rev 0.22. App update equality (av = to_version; from_version differs) is validated in Go; JSON Schema cannot express sibling equality. Existing surface-specific and unknown-field compatibility rules remain unchanged.",
  "type": "object",
  "required": [
    "v",
    "p",
    "e"
  ],
  "additionalProperties": true,
  "properties": {
    "v": {
      "const": 1
    },
    "p": {
      "type": "string",
      "pattern": "^prd_[a-z0-9]{10}$"
    },
    "e": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "nonNilUuid": {
      "allOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        }
      ]
    },
    "url": {
      "$comment": "§5.1: absolute `http(s)` with a NON-EMPTY host. The scheme is matched case-insensitively because RFC 3986 §3.1 makes schemes case-insensitive and net/url lower-cases them, so the server accepts `HTTPS://`. The pattern approximates RFC 3986 reg-name syntax; net/url additionally tolerates a raw `<`, `\"` or `]` inside a host, which this pattern rejects and which no sender emits.",
      "type": "string",
      "maxLength": 2048,
      "pattern": "^[hH][tT][tT][pP][sS]?://([^/?#@]*@)?(\\[[0-9A-Fa-f:.]+\\]|(%[89A-Fa-f][0-9A-Fa-f]|[^\\x00-\\x20\"%/<>?#@\\[\\]\\\\^`{|}:])+)(:[0-9]*)?([/?#]|$)",
      "not": {
        "$comment": "net/url rejects an ASCII control character anywhere in a URL, path included.",
        "pattern": "[\\x00-\\x1F\\x7F]"
      }
    },
    "referrer": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "$ref": "#/$defs/url"
        }
      ]
    },
    "calendarDay": {
      "$comment": "§5.1 `fd` is a DAY, not a shape: the server parses it with time.Parse, so 2026-02-30 and 2026-02-29 are rejected. The pattern is leap-year accurate.",
      "type": "string",
      "format": "date",
      "maxLength": 10,
      "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$"
    },
    "cookieVisitorID": {
      "$comment": "§5.1 `vid`: the cookie-mode identifier, 16 random bytes in base64url. The pattern is deliberately one a UUID CANNOT satisfy -- boundary 2 of spec/snippet.md §7 forbids the web cookie id and `install_id` meeting, and a grammar that cannot express a UUID makes that checkable here rather than in identity.go. The empty alternative is §5.1's `an empty X is an absent X`, which the parser has for `f`, `a` and `v`; rev 0.15 exists because this schema was once stricter than the parser on exactly that.",
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9_-]{22}$"
    },
    "firstTouch": {
      "$comment": "An empty optional string is an absent one to the server (§5.1) -- optionalString returns \"\" and the parser skips the pattern, exactly as `r` treats \"\".",
      "type": "string",
      "maxLength": 200,
      "anyOf": [
        {
          "const": ""
        },
        {
          "pattern": "^(ref:[a-z0-9.-]{1,64}|[a-z0-9._-]{1,64}(~[a-z0-9._-]{1,64}){0,2})$"
        }
      ]
    },
    "appSlug": {
      "$comment": "§5.2 `a`; \"\" is absent, and an absent slug falls back to `os`.",
      "type": "string",
      "maxLength": 32,
      "anyOf": [
        {
          "const": ""
        },
        {
          "pattern": "^[a-z0-9-]{1,32}$"
        }
      ]
    },
    "props": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[a-z0-9_]{1,32}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 200
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "event": {
      "type": "object",
      "required": [
        "n",
        "s"
      ],
      "additionalProperties": true,
      "$comment": "Common §3 fields only; every surface field is in the allOf below.",
      "properties": {
        "id": {
          "$ref": "#/$defs/nonNilUuid"
        },
        "n": {
          "type": "string",
          "pattern": "^[a-z0-9_:.-]{1,64}$"
        },
        "t": {
          "$comment": "§3 clamps EVERY `t` -- outside [ingest_ts - 30 d, ingest_ts + 5 min] it becomes `ingest_ts` -- so no bound belongs here. `minimum: 0` contradicted spec/sdk-conformance.md C15, which forbids an SDK correcting its own clock: a host clock set before 1970 made a conformance run fail a body the server stores. `type: integer` stays, and since rev 0.16 the parser agrees with what it means: a whole NUMBER, zero fraction and exponent form included, saturating outside int64 rather than rejecting.",
          "type": "integer"
        },
        "s": {
          "enum": [
            "web",
            "app"
          ]
        },
        "props": {
          "$ref": "#/$defs/props"
        },
        "i": {
          "type": "boolean",
          "default": true
        },
        "v": {
          "$comment": "§3 `v`, normative prose since rev 0.16 -- this pattern used to live only here, so the server applied nothing and stored `1.2.0` and `Electron/1.0` in a LowCardinality column nothing folds. An empty `v` is an ABSENT `v`, §5.1 `f` and §5.2 `a`'s rule, which is why `\"\"` is accepted beside the pattern rather than excluded by its `{1,24}` tail.",
          "type": "string",
          "maxLength": 32,
          "anyOf": [
            {
              "const": ""
            },
            {
              "pattern": "^[a-z]+/[0-9A-Za-z.+-]{1,24}$"
            }
          ]
        },
        "l": {
          "type": "string",
          "maxLength": 16
        }
      },
      "allOf": [
        {
          "$comment": "§5.1 web surface fields.",
          "if": {
            "required": [
              "s"
            ],
            "properties": {
              "s": {
                "const": "web"
              }
            }
          },
          "then": {
            "required": [
              "u"
            ],
            "properties": {
              "u": {
                "$ref": "#/$defs/url"
              },
              "r": {
                "$ref": "#/$defs/referrer"
              },
              "w": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "pv": {
                "$ref": "#/$defs/uuid"
              },
              "e": {
                "$comment": "§5.1: `e` is clamped to [0, 1 800 000], and a larger value \"is clamped, not rejected\" -- enrich.go's `clamp` is what implements it. The bounds here rejected events the server stores, so the schema was the outlier and they are gone at rev 0.16.",
                "type": "integer"
              },
              "sd": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "f": {
                "$ref": "#/$defs/firstTouch"
              },
              "fd": {
                "type": "string",
                "maxLength": 10
              },
              "vid": {
                "$ref": "#/$defs/cookieVisitorID"
              }
            },
            "allOf": [
              {
                "$comment": "§5.1 `fd`: MUST if `f`, and only then is it read as a day.",
                "if": {
                  "required": [
                    "f"
                  ],
                  "properties": {
                    "f": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "then": {
                  "required": [
                    "fd"
                  ],
                  "properties": {
                    "fd": {
                      "$ref": "#/$defs/calendarDay"
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "$comment": "§5.2 app surface fields.",
          "if": {
            "required": [
              "s"
            ],
            "properties": {
              "s": {
                "const": "app"
              }
            }
          },
          "then": {
            "required": [
              "iid",
              "av",
              "os",
              "osv",
              "arch"
            ],
            "properties": {
              "iid": {
                "$ref": "#/$defs/nonNilUuid"
              },
              "av": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "os": {
                "enum": [
                  "macos",
                  "windows",
                  "linux"
                ]
              },
              "osv": {
                "type": "string",
                "maxLength": 32
              },
              "arch": {
                "enum": [
                  "arm64",
                  "x64",
                  "x86"
                ]
              },
              "a": {
                "$ref": "#/$defs/appSlug"
              }
            }
          }
        },
        {
          "$comment": "§4: `pageview` is a web event.",
          "if": {
            "required": [
              "n"
            ],
            "properties": {
              "n": {
                "const": "pageview"
              }
            }
          },
          "then": {
            "properties": {
              "s": {
                "const": "web"
              }
            }
          }
        },
        {
          "$comment": "§4: `click:download` is a web event carrying the file basename.",
          "if": {
            "required": [
              "n"
            ],
            "properties": {
              "n": {
                "const": "click:download"
              }
            }
          },
          "then": {
            "required": [
              "props"
            ],
            "properties": {
              "s": {
                "const": "web"
              },
              "props": {
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "$comment": "§4: `click:outbound` is a web event carrying the outbound hostname.",
          "if": {
            "required": [
              "n"
            ],
            "properties": {
              "n": {
                "const": "click:outbound"
              }
            }
          },
          "then": {
            "required": [
              "props"
            ],
            "properties": {
              "s": {
                "const": "web"
              },
              "props": {
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "$comment": "§4/§5.1: `engagement`. `pv` is the `id` of a pageview and §3 forbids a nil `id`.",
          "if": {
            "required": [
              "n"
            ],
            "properties": {
              "n": {
                "const": "engagement"
              }
            }
          },
          "then": {
            "required": [
              "u",
              "pv",
              "e",
              "sd"
            ],
            "properties": {
              "s": {
                "const": "web"
              },
              "pv": {
                "$ref": "#/$defs/nonNilUuid"
              }
            }
          }
        },
        {
          "$comment": "§4: `heartbeat` is an app event; its install properties are strings matching `^[a-z0-9_.-]{1,24}$`, `license` included. At rev 0.16 §4 moved onto that same grammar (W10) and its unenforced five-key cap became §3's twenty (W9), which `$defs/props` already states as `maxProperties`. This branch was already right on both counts and is unchanged.",
          "if": {
            "required": [
              "n"
            ],
            "properties": {
              "n": {
                "const": "heartbeat"
              }
            }
          },
          "then": {
            "properties": {
              "s": {
                "const": "app"
              },
              "props": {
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-z0-9_.-]{1,24}$"
                }
              }
            }
          }
        },
        {
          "$comment": "§4: `install` is an app event.",
          "if": {
            "required": [
              "n"
            ],
            "properties": {
              "n": {
                "const": "install"
              }
            }
          },
          "then": {
            "properties": {
              "s": {
                "const": "app"
              }
            }
          }
        },
        {
          "$comment": "§4: the `onboarding:` namespace is app-only.",
          "if": {
            "required": [
              "n"
            ],
            "properties": {
              "n": {
                "pattern": "^onboarding:"
              }
            }
          },
          "then": {
            "required": [
              "props"
            ],
            "properties": {
              "s": {
                "const": "app"
              },
              "n": {
                "pattern": "^onboarding:[a-z0-9_-]{1,32}$"
              },
              "props": {
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "ok",
                      "fail",
                      "skip"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^[a-z0-9_.-]+$"
                  }
                }
              }
            }
          }
        },
        {
          "$comment": "§4: automatic app version transition, fixed properties and required stable event ID.",
          "if": {
            "required": [
              "n"
            ],
            "properties": {
              "n": {
                "const": "app_updated"
              }
            }
          },
          "then": {
            "required": [
              "id",
              "props"
            ],
            "properties": {
              "s": {
                "const": "app"
              },
              "props": {
                "type": "object",
                "required": [
                  "from_version",
                  "to_version"
                ],
                "additionalProperties": false,
                "properties": {
                  "from_version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "pattern": "\\S"
                  },
                  "to_version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "pattern": "\\S"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
